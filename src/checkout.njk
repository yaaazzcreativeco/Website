---
layout: base.njk
title: Checkout
permalink: /checkout/index.html
---
<section class="max-w-7xl mx-auto px-6 pt-8 pb-16">
  <header class="mb-10 relative">
    <h1 class="font-headline font-black text-4xl md:text-5xl text-primary mb-2">Complete your order!</h1>
    <p class="text-on-surface font-medium opacity-80">Fill in your shipping details and submit — we'll take it from there! 🎀</p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-7 space-y-8">
      <div
        class="space-y-8"
        id="checkout-form"
        data-shop-url="{{ '/shop/' | url }}"
      >

        <section class="bg-surface-container-low rounded-2xl p-6 md:p-8 shadow-sm border border-outline-variant/20">
          <h2 class="font-headline font-bold text-2xl text-on-surface mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">local_shipping</span>
            Shipping Information
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="md:col-span-2">
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-name">Full name</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-name" name="name" autocomplete="off" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-email">Email</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-email" name="email" type="email" autocomplete="off" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-phone">Mobile / Phone</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-phone" name="phone" autocomplete="off" required/>
            </div>
            <div class="md:col-span-2">
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-address">Street Address / House No. / Building</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-address" name="address" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-barangay">Barangay</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-barangay" name="barangay" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-city">City / Municipality</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-city" name="city" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-province">Province</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-province" name="province" required/>
            </div>
            <div>
              <label class="text-sm font-bold text-on-surface-variant ml-1" for="ship-postal">Postal Code</label>
              <input class="mt-1 w-full bg-surface-container-highest border-none rounded-full px-5 py-3 focus:ring-2 focus:ring-primary-container text-on-surface" id="ship-postal" name="postal" inputmode="numeric"/>
            </div>
          </div>
        </section>

        <section class="bg-primary-container/25 rounded-2xl p-6 md:p-8 border border-primary/10">
          <div class="flex justify-between items-start mb-3">
            <h2 class="font-headline font-bold text-xl text-on-surface">Chat With Us</h2>
            <div id="live-status-pill" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest transition-all duration-500 shadow-sm border">
              <span class="relative flex h-3 w-3" id="status-indicator-dots">
                <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-green-400"></span>
                <span id="status-dot" class="relative inline-flex rounded-full h-3 w-3 bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
              </span>
              <span id="live-status-text">CHECKING...</span>
            </div>
          </div>
          <p class="text-on-surface-variant text-sm mb-4 leading-relaxed">
            Have a question about your order or shipping? Our team is happy to help!
            Click the button below to open our Live Chat.
          </p>
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <div class="flex items-center gap-2 text-xs font-medium text-on-surface-variant bg-surface-container-low/50 w-fit px-3 py-2 rounded-lg border border-outline-variant/10">
              <span class="material-symbols-outlined text-sm text-primary">schedule</span>
              <span><strong>Chat Schedule:</strong> 8:00 AM – 5:00 PM, Monday to Saturday</span>
            </div>
            <button type="button" id="btn-open-chat" class="inline-flex items-center justify-center gap-2 bg-surface-container-low/50 text-on-surface-variant font-bold py-2 px-3 rounded-lg border border-outline-variant/10 hover:bg-primary-container/40 transition-all hover:scale-[1.02] active:scale-95 text-xs">
              <div class="relative flex h-2 w-2" id="chat-status-indicator">
                <span id="chat-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span id="chat-dot" class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
              </div>
              <span class="material-symbols-outlined text-primary text-sm">chat</span>
              Chat with Our Team
            </button>
          </div>
          <button type="button" id="btn-submit-order" class="w-full inline-flex items-center justify-center gap-3 bg-primary text-on-primary font-headline font-black py-4 px-8 rounded-full shadow-lg hover:opacity-95 transition-all hover:scale-[1.02] active:scale-95 text-lg">
            <span class="material-symbols-outlined">send_and_archive</span>
            SUBMIT ORDER
          </button>
          
          <div id="order-success" class="hidden">
            <div class="relative overflow-hidden p-8 rounded-[2rem] bg-gradient-to-br from-[#2c673c] to-[#1e4a2a] text-white text-center shadow-xl transform transition-all duration-700 animate-[slideUp_0.6s_cubic-bezier(0.34,1.56,0.64,1)]">
              <div class="inline-flex items-center justify-center w-20 h-20 bg-white/10 rounded-full mb-6 relative">
                <div class="absolute inset-0 bg-white/20 rounded-full animate-ping" style="animation-duration: 2s;"></div>
                <span class="material-symbols-outlined text-white text-4xl relative z-10" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              </div>
              <h3 class="font-headline font-black text-3xl mb-4 tracking-tight">Order Received! 🎀</h3>
              <p class="text-white/90 text-base leading-relaxed mb-4 max-w-md mx-auto">
                Thank you! Your order has been securely sent. Please <strong>check your email inbox</strong> for your order confirmation and summary. 📧
              </p>
              <div class="bg-black/15 rounded-xl p-4 mt-6 backdrop-blur-sm border border-white/10">
                <p class="text-white/95 text-sm leading-relaxed">
                  Our team will contact you <strong>shortly</strong> with your exact delivery fee and payment details. We can't wait to prepare this for you! ✨
                </p>
              </div>
            </div>
          </div>

        </section>
      </div>
    </div>

    <aside class="lg:col-span-5 lg:sticky lg:top-28">
      <div class="bg-secondary-fixed/25 p-6 md:p-8 shadow-sm rounded-2xl border border-secondary/20">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-headline font-black text-2xl text-on-surface flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">shopping_basket</span>
            Order summary
          </h2>
          <button id="btn-clear-cart-summary" class="flex items-center gap-1.5 text-xs font-bold text-rose-500 hover:text-rose-600 hover:bg-rose-50 px-3 py-1.5 rounded-full transition-all">
            <span class="material-symbols-outlined text-sm">delete_sweep</span>
            Clear All
          </button>
        </div>
        <div id="checkout-lines" class="space-y-5"></div>
        <div class="mt-8 pt-6 border-t border-secondary/20 space-y-3 text-sm">
          <div class="flex justify-between pt-2 text-lg font-headline font-black text-secondary">
            <span>Items Subtotal</span>
            <span id="sum-sub">₱0</span>
          </div>
          <p class="text-xs text-on-surface-variant font-medium text-right">*Shipping fee confirmed by our team</p>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  (function () {
    function money(n) {
      var v = Number(n) || 0;
      return "₱" + v.toLocaleString("en-PH");
    }
    function render() {
      var cart = window.YaaazzCart.get();
      var wrap = document.getElementById("checkout-lines");
      wrap.innerHTML = "";
      if (!cart.length) {
        var shopUrl = document.getElementById("checkout-form").getAttribute("data-shop-url") || "/shop/";
        wrap.innerHTML = '<p class="text-on-surface-variant">Your cart is empty. <a class="font-bold text-primary underline" href="' + shopUrl + '">Go to shop</a>.</p>';
        document.getElementById("sum-sub").textContent = money(0);
        return;
      }
      cart.forEach(function (line) {
        var row = document.createElement("div");
        row.className = "flex gap-4 items-start";
        row.innerHTML =
          '<div class="w-14 h-14 rounded-lg overflow-hidden shrink-0 bg-surface-container">' +
          (line.image ? '<img alt="" class="w-full h-full object-cover" src="' + line.image + '"/>' : "") +
          "</div>" +
          '<div class="flex-1 min-w-0">' +
          '<p class="font-headline font-bold text-on-surface truncate">' +
          line.title +
          "</p>" +
          '<p class="text-xs text-on-surface-variant">' +
          money(line.price) +
          " × " +
          line.qty +
          (line.isPreOrder ? ' <span class="text-amber-700 font-bold">[PRE-ORDER]</span>' : "") +
          "</p>" +
          '<label class="sr-only" for="q-' + line.slug + '">Qty</label>' +
          '<div class="mt-2 flex items-center gap-2">' +
          '<button type="button" class="qty-down px-2 py-1 rounded-full bg-surface-container-highest text-on-surface" data-slug="' +
          line.slug +
          '">−</button>' +
          '<input id="q-' +
          line.slug +
          '" class="w-12 text-center bg-transparent font-bold" inputmode="numeric" value="' +
          line.qty +
          '" data-slug="' +
          line.slug +
          '"/>' +
          '<button type="button" class="qty-up px-2 py-1 rounded-full bg-surface-container-highest text-on-surface" data-slug="' +
          line.slug +
          '">+</button>' +
          "</div>" +
          "</div>" +
          '<div class="text-right font-bold text-on-surface">' +
          money(line.price * line.qty) +
          "</div>";
        wrap.appendChild(row);
      });
      var sub = window.YaaazzCart.subtotal();
      document.getElementById("sum-sub").textContent = money(sub);

      wrap.querySelectorAll(".qty-down").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var slug = btn.getAttribute("data-slug");
          var line = window.YaaazzCart.get().find(function (l) { return l.slug === slug; });
          if (!line) return;
          window.YaaazzCart.setQty(slug, (Number(line.qty) || 1) - 1);
          render();
        });
      });
      wrap.querySelectorAll(".qty-up").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var slug = btn.getAttribute("data-slug");
          var line = window.YaaazzCart.get().find(function (l) { return l.slug === slug; });
          if (!line) return;
          window.YaaazzCart.setQty(slug, (Number(line.qty) || 1) + 1);
          render();
        });
      });
    }

    function buyerFromForm() {
      return {
        name: document.getElementById("ship-name").value.trim(),
        email: document.getElementById("ship-email").value.trim(),
        phone: document.getElementById("ship-phone").value.trim(),
        address: document.getElementById("ship-address").value.trim(),
        barangay: document.getElementById("ship-barangay") ? document.getElementById("ship-barangay").value.trim() : "",
        city: document.getElementById("ship-city").value.trim(),
        province: document.getElementById("ship-province") ? document.getElementById("ship-province").value.trim() : "",
        postal: document.getElementById("ship-postal").value.trim()
      };
    }

    var submitBtn = document.getElementById("btn-submit-order");

    function buildOrderSummary(buyer) {
      var cart = window.YaaazzCart.get();
      var subtotal = window.YaaazzCart.subtotal();
      var lines = ["=== YAAAZZ ORDER ==="];
      cart.forEach(function(l) {
        var line = "• " + l.qty + " x " + l.title + " — " + money(l.price) + " (line total: " + money(l.price * l.qty) + ")";
        if (l.isPreOrder) line += " [PRE-ORDER]";
        lines.push(line);
      });
      lines.push("");
      lines.push("Items Subtotal: " + money(subtotal));
      lines.push("Shipping Fee: To be confirmed by our team");
      lines.push("");
      lines.push("--- Shipping Details ---");
      lines.push("Name: " + (buyer.name || ""));
      lines.push("Phone: " + (buyer.phone || ""));
      lines.push("Email: " + (buyer.email || ""));
      lines.push("Address: " + [buyer.address, buyer.barangay, buyer.city, buyer.province, buyer.postal].filter(Boolean).join(", "));
      return lines.join("\n");
    }

    function showErrorModal(message) {
      var modal = document.getElementById("error-modal");
      var text = document.getElementById("error-modal-message");
      if (modal && text) {
        text.innerHTML = message;
        modal.classList.add("show");
      } else {
        alert(message.replace(/<br>/g, "\n").replace(/<b>/g, "").replace(/<\/b>/g, ""));
      }
    }

    function setSubmitting(active) {
      if (!submitBtn) return;
      if (active) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined" style="animation:spin 1s linear infinite;">refresh</span><span>Sending your order…</span>';
        submitBtn.style.opacity = "0.75";
      } else {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-symbols-outlined">send_and_archive</span>SUBMIT ORDER';
        submitBtn.style.opacity = "1";
      }
    }

    function showSuccessScreen() {
      if (submitBtn) {
        submitBtn.style.display = "none";
      }
      var success = document.getElementById("order-success");
      if (success) {
        success.classList.remove("hidden");
        setTimeout(function() {
          success.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 100);
      }
    }

    if (submitBtn) {
      submitBtn.addEventListener("click", function (e) {
        e.preventDefault();

        // Validate required fields
        var requiredFields = document.getElementById("checkout-form").querySelectorAll("input[required]");
        for (var i = 0; i < requiredFields.length; i++) {
          if (!requiredFields[i].value.trim()) {
            requiredFields[i].reportValidity();
            return;
          }
        }

        if (!window.YaaazzCart.get().length) {
          alert("Your cart is empty.");
          return;
        }

        var buyer = buyerFromForm();
        var orderSummary = buildOrderSummary(buyer);
        var shortId = Math.random().toString(36).substring(2, 6).toUpperCase();
        var dateStr = new Date().toLocaleDateString("en-PH", { month: "short", day: "numeric", year: "numeric" });
        var subject = "Yaaazz Order - " + buyer.name + " [" + dateStr + " #" + shortId + "]";

        setSubmitting(true);

        var formData = new FormData();
        formData.append("access_key", "d7a2a015-babe-4b35-95bc-f92acf1060e8");
        formData.append("subject", subject);
        formData.append("replyto", buyer.email);
        formData.append("botcheck", "");
        formData.append("name", buyer.name);
        formData.append("email", buyer.email);
        formData.append("phone", buyer.phone);
        formData.append("address", buyer.address);
        formData.append("barangay", buyer.barangay);
        formData.append("city", buyer.city);
        formData.append("province", buyer.province);
        formData.append("postal", buyer.postal);
        formData.append("order_summary", orderSummary);

        fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
          headers: { "Accept": "application/json" }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.success === "true" || data.success === true) {
            showSuccessScreen();
            window.YaaazzCart.clear();
          } else {
            throw new Error(data.message || "Could not send order.");
          }
        })
        .catch(function(err) {
          setSubmitting(false);
          showErrorModal("Sorry, there was a problem sending your order. Please try again or reach us via Live Chat.<br><br><b>Error:</b> " + (err.message || "Unknown error"));
        });
      });
    }

    // Open chat button (optional, for inquiries only)
    var chatBtn = document.getElementById("btn-open-chat");
    if (chatBtn) {
      chatBtn.addEventListener("click", function() {
        if (typeof Tawk_API !== "undefined") {
          if (Tawk_API.maximize) Tawk_API.maximize();
          else if (Tawk_API.toggle) Tawk_API.toggle();
        }
      });
    }

    function updateLiveStatus() {
      var pill = document.getElementById("live-status-pill");
      var text = document.getElementById("live-status-text");
      var dot = document.getElementById("status-dot");
      var ping = document.getElementById("status-ping");
      
      var chatBtn = document.getElementById("btn-open-chat");
      var chatDot = document.getElementById("chat-dot");
      var chatPing = document.getElementById("chat-ping");

      if (!pill || !text) return;

      var now = new Date();
      var day = now.getDay();
      var hour = now.getHours();

      var isOpen = day >= 1 && day <= 6 && hour >= 8 && hour < 17;

      if (isOpen) {
        pill.className = "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest transition-all duration-500 shadow-[0_0_15px_rgba(34,197,94,0.3)] border border-green-500/40 bg-green-500/15 text-green-700";
        text.textContent = "LIVE NOW";
        dot.className = "relative inline-flex rounded-full h-3 w-3 bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.8)]";
        ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75";
        
        if (chatBtn) {
          chatBtn.classList.add("chat-btn-live");
          if (chatDot) chatDot.className = "relative inline-flex rounded-full h-2 w-2 bg-green-500";
          if (chatPing) chatPing.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75";
        }
      } else {
        pill.className = "inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest transition-all duration-500 border border-outline-variant/30 bg-surface-container-highest text-on-surface-variant/60";
        text.textContent = "OFFLINE";
        dot.className = "relative inline-flex rounded-full h-3 w-3 bg-on-surface-variant/40";
        ping.className = "hidden";
        
        if (chatBtn) {
          chatBtn.classList.remove("chat-btn-live");
          if (chatDot) chatDot.className = "relative inline-flex rounded-full h-2 w-2 bg-on-surface-variant/30";
          if (chatPing) chatPing.className = "hidden";
        }
      }
    }

    function boot() {
      render();
      updateLiveStatus();

      // Clear cart button in order summary
      var clearBtn = document.getElementById("btn-clear-cart-summary");
      var modal = document.getElementById("clear-cart-modal");
      var modalYes = document.getElementById("clear-modal-yes");
      var modalNo = document.getElementById("clear-modal-no");
      if (clearBtn && modal && modalYes && modalNo) {
        clearBtn.addEventListener("click", function() {
          if (window.YaaazzCart.get().length === 0) return;
          modal.classList.add("show");
        });
        modalYes.addEventListener("click", function() {
          window.YaaazzCart.clear();
          render();
          modal.classList.remove("show");
        });
        modalNo.addEventListener("click", function() {
          modal.classList.remove("show");
        });
        modal.addEventListener("click", function(e) {
          if (e.target === modal) modal.classList.remove("show");
        });
      }

      var errModal = document.getElementById("error-modal");
      var errModalClose = document.getElementById("error-modal-close");
      if (errModal && errModalClose) {
        errModalClose.addEventListener("click", function() {
          errModal.classList.remove("show");
        });
        errModal.addEventListener("click", function(e) {
          if (e.target === errModal) errModal.classList.remove("show");
        });
      }
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
    else boot();
    window.addEventListener("yaaazz:cart", render);
  })();
</script>

<style>
  @keyframes slideUp {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  #checkout-form input:-webkit-autofill,
  #checkout-form input:-webkit-autofill:hover,
  #checkout-form input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #e3ddc5 inset !important;
    box-shadow: 0 0 0 1000px #e3ddc5 inset !important;
    -webkit-text-fill-color: #312f23 !important;
    caret-color: #312f23 !important;
    transition: background-color 99999s ease-in-out 0s;
  }

  #btn-submit-order.checkout-submit-done {
    background: linear-gradient(135deg, #2c673c, #215d33);
    animation: checkoutBtnPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes checkoutBtnPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.06); }
    100% { transform: scale(1.05); }
  }
  @keyframes spin {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .chat-btn-live {
    border-color: rgba(34, 197, 94, 0.4) !important;
    background-color: rgba(34, 197, 94, 0.08) !important;
    animation: chatGlowPulse 2s infinite alternate;
  }
  @keyframes chatGlowPulse {
    from { box-shadow: 0 0 0px rgba(34, 197, 94, 0); }
    to { box-shadow: 0 0 12px rgba(34, 197, 94, 0.25); }
  }


  /* Custom Confirmation Modal */
  #clear-cart-modal, #error-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
  }
  #clear-cart-modal.show, #error-modal.show {
    display: flex;
  }
  .clear-modal-box {
    background: #fff;
    border-radius: 24px;
    padding: 32px 28px;
    max-width: 340px;
    width: 90%;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.2);
    animation: modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes modalPop {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .clear-modal-icon {
    width: 64px;
    height: 64px;
    background: #fee2e2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }
  .clear-modal-icon .material-symbols-outlined {

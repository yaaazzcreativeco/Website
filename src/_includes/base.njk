<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
{% include "seo.njk" %}
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  
  {% set currentTitle = title + " | " + settings.site_name if title else settings.site_name %}
  {% set currentDescription = description | default(settings.site_description) %}
  {% set currentUrl = settings.site_url + page.url %}
  {% set currentImage = main_image | default(settings.logo_url) | sitePath %}
  {% if not currentImage.startsWith('http') %}{% set currentImage = settings.site_url + currentImage %}{% endif %}

  <title>{{ currentTitle }}</title>
  <meta name="description" content="{{ currentDescription }}">
  <link rel="canonical" href="{{ currentUrl }}">

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ currentUrl }}">
  <meta property="og:title" content="{{ currentTitle }}">
  <meta property="og:description" content="{{ currentDescription }}">
  <meta property="og:image" content="{{ currentImage }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  {# Restored full icons to fix the "text instead of icon" issue #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block">
  
  {# Main Fonts - Keeping display=swap for performance #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Be+Vietnam+Pro:wght@300;400;500;600&amp;family=Caveat:wght@400;700&amp;family=Gochi+Hand&amp;display=swap">
  
  <link rel="preload" href="/static/css/main.css" as="style">
  <link rel="stylesheet" href="/static/css/main.css">
</head>
<body class="bg-background text-on-surface font-body selection:bg-primary-container selection:text-on-primary-container min-h-screen overflow-x-hidden{% if bodyClass %} {{ bodyClass }}{% endif %}">
  <script src="/js/cart.js" defer></script>
  <div class="grainy-overlay" aria-hidden="true"></div>
  {% include "partials/header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}

  {% if settings.tawk_property_id and settings.tawk_widget_id %}
  <!-- Start of Tawk.to Script -->
  <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src='https://embed.tawk.to/{{ settings.tawk_property_id }}/{{ settings.tawk_widget_id }}';
      s1.charset='UTF-8';
      s1.setAttribute('crossorigin','*');
      s0.parentNode.insertBefore(s1,s0);
    })();
  </script>
  <!-- End of Tawk.to Script -->
  {% endif %}
</body>
</html>
